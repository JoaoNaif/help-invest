NODE_ENV=development
PORT=3333

# Postgres — bate com o docker-compose.yml (porta 5433 no host)
DATABASE_URL="postgresql://helpinvest:helpinvest@localhost:5433/helpinvest?schema=public"

# Front: origens liberadas no CORS (separadas por vírgula).
# Padrão: http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000

# Limite de requisições por IP. Padrão: true (os testes e2e desligam)
# RATE_LIMIT_ENABLED=true

# Validade do access token (JWT). Padrão: 15m. Sessão longa virá do refresh token.
# JWT_EXPIRES_IN=15m

# Auth — par de chaves RSA (RS256) em base64, PEM PKCS8 (private) / SPKI (public).
# Gerar:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("private.pem"))
#   Linux/macOS:           base64 -w0 private.pem
JWT_PRIVATE_KEY="change-me"
JWT_PUBLIC_KEY="change-me"

# Anthropic — leitura de prints/textos e explicação das comparações (LlmGateway).
# Sem a chave, o LLM fica indisponível (503) e só a comparação manual funciona.
# Chave em https://console.anthropic.com (a API é cobrada à parte do plano Claude).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Sincronização de Selic/CDI/IPCA com o BCB (API pública, sem chave).
# Roda ao subir o app e a cada 6 h. Padrão: true
# INDICATORS_SYNC_ENABLED=true
